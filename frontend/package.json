{
  "name": "doyo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "phone": "node scripts/phone.mjs",
    "rebuild": "node scripts/phone.mjs build",
    "test:staging": "node --env-file-if-exists=e2e/.env.e2e.local e2e/run.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "android": "expo run:android",
    "android:apk": "cd android && .\\gradlew.bat assembleRelease",
    "android:aab": "cd android && .\\gradlew.bat bundleRelease --no-daemon -PreactNativeArchitectures=armeabi-v7a,arm64-v8a,x86,x86_64",
    "release:aab": "node scripts/release.mjs aab",
    "release:apk": "node scripts/release.mjs apk",
    "ios": "expo run:ios",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "web": "expo start --web",
    "deploy:web": "cd website && npm ci && npm run build && cd .. && wrangler deploy --config wrangler.jsonc",
    "preview": "cd website && npm ci && npm run build && cd .. && wrangler dev --config wrangler.jsonc",
    "native:restore": "python scripts/restore-native-edits.py && node scripts/native-fingerprint.mjs",
    "device": "node scripts/device.mjs",
    "i18n:missing": "node scripts/scankeys.mjs",
    "i18n:dupes": "node scripts/dupkeys.mjs",
    "dev": "expo start --dev-client --host lan"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@maplibre/maplibre-react-native": "^11.3.7",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/stack": "^7.10.24",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.17",
    "expo-asset": "~57.0.15",
    "expo-build-properties": "~57.0.15",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "expo-updates": "~57.0.27",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-webview": "~14.0.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@types/react": "~19.2.10",
    "typescript": "~7.0.2",
    "wrangler": "^4.103.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-webview",
        "react-native-screens",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-reanimated",
        "typescript"
      ]
    }
  },
  "private": true
}
